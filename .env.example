INGEST_API_KEY=replace-with-at-least-16-random-characters
COMPOSE_PROJECT_NAME=sky-tracker
PUBLIC_PORT=8931
PUBLIC_BASE_URL=http://127.0.0.1:8931
ACTIVE_SECONDS=90
RETENTION_HOURS=2160
MAP_TILE_CACHE_MAX_MB=512
ENRICHMENT_ENABLED=true
RADIO_AUDIO_DEVICE=plughw:2,0
CAPTURE_AUDIO_DEVICE=plughw:2,0

# Pi: reach the ASR service over the Mac's Tailscale address.
DIALOGUE_ASR_URL=http://100.x.y.z:8903/recognize
# Optional override; defaults to healthz beside the recognition endpoint.
DIALOGUE_ASR_HEALTH_URL=
DIALOGUE_OLLAMA_URL=http://100.x.y.z:8904

# Optional pilot conversation. Keep false for deterministic fixed templates.
DIALOGUE_LLM_ENABLED=false
DIALOGUE_OLLAMA_MODEL=gemma4:e2b
# Mac ASR service (docker-compose.asr.yml).
ASR_BIND_ADDRESS=100.x.y.z
ASR_PORT=8903
LLM_BIND_ADDRESS=100.x.y.z
OLLAMA_PORT=8904
ASR_BASE_IMAGE=m.daocloud.io/docker.io/library/python:3.12-bookworm
OLLAMA_IMAGE_MIRROR=m.daocloud.io/docker.io/ollama/ollama:0.40.6
HF_ENDPOINT=https://hf-mirror.net
MODEL_DOWNLOAD_ENDPOINT=https://modelscope.cn/models/pengzhendong
# Gemma GGUF is downloaded from ModelScope with resume and SHA-256 verification.
OLLAMA_MODEL_URL=https://modelscope.cn/models/unsloth/gemma-4-E2B-it-GGUF/resolve/master/gemma-4-E2B-it-Q4_K_M.gguf
OLLAMA_MODEL_FILE=gemma-4-E2B-it-Q4_K_M.gguf
OLLAMA_MODEL_SIZE=3106738272
OLLAMA_MODEL_SHA256=740185b21d22ceb83a11c3aa62ad5842ef32c70f6096d756bbee85a1e4ec34b8
# small.en is substantially more accurate than tiny.en.
FASTER_WHISPER_MODEL=small.en
FASTER_WHISPER_CPU_THREADS=4
FASTER_WHISPER_BEAM_SIZE=5
PIPER_VOICE=en_US-hfc_male-medium
